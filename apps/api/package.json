{
  "name": "@syncacademy/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "worker": "node dist/worker.js",
    "bootstrap": "node dist/bootstrap.js",
    "prisma:generate": "prisma generate",
    "migrate": "node scripts/deploy-migrations.cjs",
    "test:integration": "node --test test/auth.test.cjs",
    "test:announcement-media": "node --test test/announcement-media.test.cjs test/announcement-s3.test.cjs",
    "test:parent-mobile": "node --test test/parent-mobile.test.cjs",
    "test:security-hardening": "node --test test/security-hardening.test.cjs",
    "test:audit-log": "node --test test/audit-log.test.cjs",
    "test": "npm run test:integration",
    "test:monitoring": "node --test test/monitoring.test.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/platform-socket.io": "^11.2.7",
    "@nestjs/websockets": "^11.2.7",
    "@prisma/client": "6.19.3",
    "argon2": "0.44.0",
    "connect-pg-simple": "10.0.0",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "express-session": "1.19.0",
    "helmet": "8.1.0",
    "nodemailer": "10.0.11",
    "otplib": "12.0.1",
    "pg": "8.16.3",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "7.0.3",
    "@types/express": "5.0.3",
    "@types/express-session": "1.18.2",
    "@types/node": "22.19.0",
    "@types/nodemailer": "7.0.4",
    "@types/pg": "8.15.6",
    "@types/qrcode": "1.5.6",
    "prisma": "6.19.3",
    "socket.io-client": "^4.8.4",
    "typescript": "5.6.3"
  }
}
