generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  HEADMASTER
  REGISTRAR
  ACADEMIC
  TEACHER
  BURSAR
  STUDENT
  PARENT
}
enum CommunicationChannel {
  SMS
  WHATSAPP
  EMAIL
}
enum DeliveryStatus {
  PENDING
  ENROUTE
  ACCEPTED
  DELIVERED
  READ
  FAILED
  REJECTED
  UNDELIVERABLE
  EXPIRED
}
model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  name String
  passwordHash String
  platformAdmin Boolean @default(false)
  enabled Boolean @default(true)
  mustChangePassword Boolean @default(false)
  sessionVersion Int @default(0)
  mfaSecret String?
  mfaLastStep BigInt @default(0)
  mfaRecovery String[] @default([])
  createdAt DateTime @default(now())
  memberships Membership[]
  resets PasswordReset[]
  students Student[]
  registryEvents RegistryEvent[]
  guardians Guardian[]
}
model School {
  academicWorkspaces AcademicWorkspace[]
  id String @id @default(uuid()) @db.Uuid
  name String
  code String @unique
  region String
  schoolType String?
  address String?
  phone String?
  email String?
  website String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  memberships Membership[]
  invitations Invitation[]
  years AcademicYear[]
  classes Classroom[]
  students Student[]
  enrollments Enrollment[]
  assignments TeachingAssignment[]
  admissions Admission[]
  registryEvents RegistryEvent[]
  subjects Subject[]
  imports StudentImport[]
  rosterIssues RosterIssue[]
  feeStructures FeeStructure[]
  studentCharges StudentCharge[]
  payments Payment[]
  adjustments Adjustment[]
  convertedLeads PlatformLead[]
  guardians Guardian[]
  studentGuardians StudentGuardian[]
  reportAccessLinks ReportAccessLink[]
  communicationLogs CommunicationLog[]
  contactVerifications ContactVerification[]
}
model PlatformLead {
  id String @id @default(uuid()) @db.Uuid
  schoolName String
  contactName String
  contactEmail String
  contactPhone String @default("")
  location String
  source String
  status String @default("new")
  studentCount Int @default(0)
  notes String @default("")
  owner String @default("")
  followUp String @default("")
  convertedSchoolId String? @db.Uuid
  school School? @relation(fields: [convertedSchoolId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
}
model PlatformSetting {
  id Int @id @default(1)
  platformName String @default("SyncAcademy")
  supportEmail String @default("")
  maintenanceMessage String @default("")
  updatedAt DateTime @updatedAt
}
model Membership {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  schoolId String @db.Uuid
  role Role
  active Boolean @default(true)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  school School @relation(fields: [schoolId], references: [id])
  assignments TeachingAssignment[]
  @@unique([userId, schoolId, role])
  @@unique([id, schoolId])
  @@index([schoolId, role, active])
}
model Invitation {
  id String @id @default(uuid()) @db.Uuid
  schoolId String? @db.Uuid
  platformAdmin Boolean @default(false)
  email String
  name String
  role Role
  tokenHash String @unique
  generation Int @default(1)
  expiresInMinutes Int @default(2880)
  expiresAt DateTime
  acceptedAt DateTime?
  revokedAt DateTime?
  invitedBy String @db.Uuid
  studentId String? @db.Uuid
  createdAt DateTime @default(now())
  school School? @relation(fields: [schoolId], references: [id])
  student Student? @relation(fields: [studentId, schoolId], references: [id, schoolId])
  @@index([schoolId, email, role])
  @@index([expiresAt])
}
model PasswordReset {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  user User @relation(fields: [userId], references: [id])
}
model AcademicYear {
  academicWorkspace AcademicWorkspace?
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  name String
  startsAt DateTime @db.Date
  endsAt DateTime @db.Date
  terms Json @default("[]")
  closed Boolean @default(false)
  school School @relation(fields: [schoolId], references: [id])
  classes Classroom[]
  admissions Admission[]
  registryEvents RegistryEvent[]
  feeStructures FeeStructure[]
  @@unique([id, schoolId])
  @@unique([schoolId, name])
}
model Classroom {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  yearId String @db.Uuid
  name String
  school School @relation(fields: [schoolId], references: [id])
  year AcademicYear @relation(fields: [yearId, schoolId], references: [id, schoolId])
  enrollments Enrollment[]
  assignments TeachingAssignment[]
  applications Admission[]
  subjects ClassSubject[]
  movementsFrom RegistryEvent[] @relation("MovementFrom")
  movementsTo RegistryEvent[] @relation("MovementTo")
  feeStructures FeeStructure[]
  @@unique([id, schoolId])
  @@unique([schoolId, yearId, name])
}
model Student {
  admissionDate DateTime? @db.Date
  ownPhone String @default("")
  guardianName String @default("")
  guardianPhone String @default("")
  version Int @default(1)
  gender String?
  address String?
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  admissionNumber String
  name String
  dateOfBirth DateTime? @db.Date
  userId String? @db.Uuid
  createdAt DateTime @default(now())
  school School @relation(fields: [schoolId], references: [id])
  user User? @relation(fields: [userId], references: [id])
  enrollments Enrollment[]
  invitations Invitation[]
  applications Admission[]
  registryEvents RegistryEvent[]
  charges StudentCharge[]
  payments Payment[]
  adjustments Adjustment[]
  guardians StudentGuardian[]
  reportLinks ReportAccessLink[]
  @@unique([id, schoolId])
  @@unique([schoolId, admissionNumber])
  @@unique([schoolId, userId])
}
model Enrollment {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  studentId String @db.Uuid
  classroomId String @db.Uuid
  createdAt DateTime @default(now())
  status String @default("active")
  version Int @default(1)
  subjects EnrollmentSubject[]
  school School @relation(fields: [schoolId], references: [id])
  student Student @relation(fields: [studentId, schoolId], references: [id, schoolId])
  classroom Classroom @relation(fields: [classroomId, schoolId], references: [id, schoolId])
  @@unique([schoolId, studentId, classroomId])
  @@unique([id, schoolId])
  @@index([schoolId, classroomId])
}

model Admission {
  admissionDate DateTime? @db.Date
  ownPhone String @default("")
  guardianName String @default("")
  guardianPhone String @default("")
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  yearId String @db.Uuid
  requestedClassId String @db.Uuid
  name String
  gender String?
  dateOfBirth DateTime? @db.Date
  address String @default("")
  status String @default("pending")
  note String @default("")
  studentId String? @db.Uuid
  createdAt DateTime @default(now())
  decidedAt DateTime?
  school School @relation(fields: [schoolId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  year AcademicYear @relation(fields: [yearId, schoolId], references: [id, schoolId], onDelete: NoAction, onUpdate: NoAction)
  requestedClass Classroom @relation(fields: [requestedClassId, schoolId], references: [id, schoolId], onDelete: NoAction, onUpdate: NoAction)
  student Student? @relation(fields: [studentId, schoolId], references: [id, schoolId], onDelete: NoAction, onUpdate: NoAction)
  @@index([schoolId, yearId, status])
}

model RegistryEvent {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  yearId String @db.Uuid
  studentId String? @db.Uuid
  actorId String @db.Uuid
  kind String
  message String
  fromClassId String? @db.Uuid
  toClassId String? @db.Uuid
  createdAt DateTime @default(now())
  school School @relation(fields: [schoolId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  year AcademicYear @relation(fields: [yearId, schoolId], references: [id, schoolId], onDelete: NoAction, onUpdate: NoAction)
  student Student? @relation(fields: [studentId, schoolId], references: [id, schoolId], onDelete: NoAction, onUpdate: NoAction)
  actor User @relation(fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fromClass Classroom? @relation("MovementFrom", fields: [fromClassId, schoolId], references: [id, schoolId], onDelete: NoAction, onUpdate: NoAction)
  toClass Classroom? @relation("MovementTo", fields: [toClassId, schoolId], references: [id, schoolId], onDelete: NoAction, onUpdate: NoAction)
  @@index([schoolId, yearId, createdAt])
  @@index([schoolId, studentId])
}
model TeachingAssignment {
  subjectId String? @db.Uuid
  subject Subject? @relation(fields: [subjectId, schoolId], references: [id, schoolId])
  confirmedAt DateTime?
  rosterIssues RosterIssue[]
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  membershipId String @db.Uuid
  classroomId String @db.Uuid
  school School @relation(fields: [schoolId], references: [id])
  membership Membership @relation(fields: [membershipId, schoolId], references: [id, schoolId])
  classroom Classroom @relation(fields: [classroomId, schoolId], references: [id, schoolId])
  @@unique([schoolId, membershipId, classroomId, subjectId])
  @@unique([id, schoolId])
}

model Subject {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  name String
  code String
  school School @relation(fields: [schoolId], references: [id])
  classes ClassSubject[]
  enrollments EnrollmentSubject[]
  assignments TeachingAssignment[]
  @@unique([id, schoolId])
  @@unique([schoolId, code])
  @@unique([schoolId, name])
}
model ClassSubject {
  schoolId String @db.Uuid
  classroomId String @db.Uuid
  subjectId String @db.Uuid
  classroom Classroom @relation(fields: [classroomId, schoolId], references: [id, schoolId])
  subject Subject @relation(fields: [subjectId, schoolId], references: [id, schoolId])
  @@id([schoolId, classroomId, subjectId])
}
model EnrollmentSubject {
  schoolId String @db.Uuid
  enrollmentId String @db.Uuid
  subjectId String @db.Uuid
  enrollment Enrollment @relation(fields: [enrollmentId, schoolId], references: [id, schoolId])
  subject Subject @relation(fields: [subjectId, schoolId], references: [id, schoolId])
  @@id([schoolId, enrollmentId, subjectId])
}
model RosterIssue {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  assignmentId String @db.Uuid
  studentId String? @db.Uuid
  reportedBy String @db.Uuid
  issueType String
  description String
  status String @default("open")
  resolution String @default("")
  resolvedBy String? @db.Uuid
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  version Int @default(1)
  school School @relation(fields: [schoolId], references: [id])
  assignment TeachingAssignment @relation(fields: [assignmentId, schoolId], references: [id, schoolId])
  @@index([schoolId, status, createdAt])
}
model StudentImport {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  actorId String @db.Uuid
  yearId String @db.Uuid
  filename String
  rows Json
  results Json
  cursor Int @default(0)
  createdAt DateTime @default(now())
  expiresAt DateTime
  school School @relation(fields: [schoolId], references: [id])
  @@index([schoolId, actorId, createdAt])
}
model AuditEvent {
  id String @id @default(uuid()) @db.Uuid
  schoolId String? @db.Uuid
  actorId String? @db.Uuid
  action String
  target String
  createdAt DateTime @default(now())
  @@index([schoolId, createdAt])
}
model Outbox {
  id String @id @default(uuid()) @db.Uuid
  payload String
  invitationId String? @db.Uuid
  invitationGeneration Int?
  resetId String? @db.Uuid
  attempts Int @default(0)
  availableAt DateTime @default(now())
  leaseUntil DateTime?
  leaseId String?
  sentAt DateTime?
  cancelledAt DateTime?
  failedAt DateTime?
  createdAt DateTime @default(now())
  channel CommunicationChannel?
  schoolId String? @db.Uuid
  idempotencyKey String?
  @@index([sentAt, failedAt, availableAt])
  @@index([schoolId, createdAt])
  @@index([idempotencyKey])
}
model RateBucket {
  key String @id
  count Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}
model Idempotency {
  scope String
  key String
  fingerprint String
  result Json
  createdAt DateTime @default(now())
  @@id([scope, key])
}

model WebSession {
  sid String @id @db.VarChar
  sess Json @db.Json
  expire DateTime @db.Timestamp(6)
  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

model FeeStructure {
  id          String     @id @default(uuid()) @db.Uuid
  schoolId    String     @db.Uuid
  yearId      String     @db.Uuid
  classroomId String     @db.Uuid
  term        String
  name        String
  amount      Int
  dueDate     DateTime   @db.Date
  locked      Boolean    @default(false)
  createdAt   DateTime   @default(now())
  school      School     @relation(fields: [schoolId], references: [id])
  year        AcademicYear @relation(fields: [yearId, schoolId], references: [id, schoolId])
  classroom   Classroom  @relation(fields: [classroomId, schoolId], references: [id, schoolId])
  charges     StudentCharge[]
  @@unique([schoolId, yearId, classroomId, term, name])
  @@index([schoolId, yearId])
}

model StudentCharge {
  payments    Payment[]
  id          String     @id @default(uuid()) @db.Uuid
  schoolId    String     @db.Uuid
  feeId       String     @db.Uuid
  studentId   String     @db.Uuid
  yearId      String     @db.Uuid
  classroomId String     @db.Uuid
  term        String
  name        String
  amount      Int
  dueDate     DateTime   @db.Date
  createdAt   DateTime   @default(now())
  school      School     @relation(fields: [schoolId], references: [id])
  fee         FeeStructure @relation(fields: [feeId], references: [id])
  student     Student    @relation(fields: [studentId, schoolId], references: [id, schoolId])
  @@unique([schoolId, feeId, studentId])
  @@index([schoolId, yearId, studentId, term])
}

model Payment {
  replacesId  String? @unique @db.Uuid
  replaces    Payment? @relation("PaymentCorrection", fields: [replacesId], references: [id], onDelete: Restrict)
  replacement Payment? @relation("PaymentCorrection")
  chargeId    String?    @db.Uuid
  charge      StudentCharge? @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  id          String     @id @default(uuid()) @db.Uuid
  schoolId    String     @db.Uuid
  yearId      String     @db.Uuid
  studentId   String     @db.Uuid
  term        String
  amount      Int
  method      String
  reference   String     @default("")
  date        DateTime   @db.Date
  receipt     String
  createdAt   DateTime   @default(now())
  voidReason  String?
  voidAt      DateTime?
  voidBy      String?    @db.Uuid
  school      School     @relation(fields: [schoolId], references: [id])
  student     Student    @relation(fields: [studentId, schoolId], references: [id, schoolId])
  @@unique([schoolId, receipt])
  @@index([schoolId, yearId, studentId, term])
  @@index([schoolId, reference])
  @@index([chargeId])
}

model Adjustment {
  id          String     @id @default(uuid()) @db.Uuid
  schoolId    String     @db.Uuid
  yearId      String     @db.Uuid
  studentId   String     @db.Uuid
  term        String
  amount      Int
  kind        String
  reason      String
  actorId     String     @db.Uuid
  createdAt   DateTime   @default(now())
  school      School     @relation(fields: [schoolId], references: [id])
  student     Student    @relation(fields: [studentId, schoolId], references: [id, schoolId])
  @@index([schoolId, yearId, studentId, term])
}

model AcademicWorkspace {
  yearId String @id @db.Uuid
  schoolId String @db.Uuid
  data Json
  revision Int @default(1)
  year AcademicYear @relation(fields: [yearId], references: [id])
  school School @relation(fields: [schoolId], references: [id])
  @@index([schoolId])
}

model Guardian {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  userId String? @db.Uuid
  name String
  phone String
  whatsappPhone String?
  email String?
  preferredChannel CommunicationChannel @default(SMS)
  preferredLanguage String @default("sw")
  phoneVerifiedAt DateTime?
  emailVerifiedAt DateTime?
  whatsappVerifiedAt DateTime?
  optOutSms Boolean @default(false)
  optOutWhatsapp Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school School @relation(fields: [schoolId], references: [id])
  user User? @relation(fields: [userId], references: [id])
  students StudentGuardian[]
  reportLinks ReportAccessLink[]
  communicationLogs CommunicationLog[]
  verifications ContactVerification[]
  @@unique([id, schoolId])
  @@unique([schoolId, phone])
  @@index([schoolId, userId])
}

model StudentGuardian {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  studentId String @db.Uuid
  guardianId String @db.Uuid
  relationship String @default("Guardian")
  isPrimary Boolean @default(false)
  canReceiveReports Boolean @default(true)
  canReceiveFinanceAlert Boolean @default(true)
  canReceiveAttendanceAlert Boolean @default(true)
  createdAt DateTime @default(now())
  school School @relation(fields: [schoolId], references: [id])
  student Student @relation(fields: [studentId, schoolId], references: [id, schoolId], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId, schoolId], references: [id, schoolId], onDelete: Cascade)
  @@unique([studentId, guardianId])
  @@unique([id, schoolId])
  @@index([schoolId, studentId])
  @@index([schoolId, guardianId])
}

model ContactVerification {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  guardianId String @db.Uuid
  channel CommunicationChannel
  destination String
  codeHash String
  expiresAt DateTime
  attempts Int @default(0)
  resendAfter DateTime
  verifiedAt DateTime?
  createdAt DateTime @default(now())
  school School @relation(fields: [schoolId], references: [id])
  guardian Guardian @relation(fields: [guardianId, schoolId], references: [id, schoolId], onDelete: Cascade)
  @@index([schoolId, guardianId, channel])
  @@index([destination, expiresAt])
}

model ReportAccessLink {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  studentId String @db.Uuid
  guardianId String @db.Uuid
  reportCardId String
  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  revokedByUserId String? @db.Uuid
  revokeReason String?
  maxAccessCount Int @default(25)
  accessCount Int @default(0)
  lastAccessedAt DateTime?
  verificationType String @default("phone_last4")
  createdAt DateTime @default(now())
  school School @relation(fields: [schoolId], references: [id])
  student Student @relation(fields: [studentId, schoolId], references: [id, schoolId], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId, schoolId], references: [id, schoolId], onDelete: Cascade)
  @@index([schoolId, studentId])
  @@index([schoolId, guardianId])
  @@index([expiresAt])
}

model CommunicationLog {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  guardianId String? @db.Uuid
  studentId String? @db.Uuid
  channel CommunicationChannel
  providerName String
  providerMessageId String?
  recipient String
  templateKey String?
  status DeliveryStatus @default(PENDING)
  unitCostTzs Int @default(0)
  segments Int @default(1)
  sentAt DateTime @default(now())
  deliveredAt DateTime?
  errorCode String?
  errorMessage String?
  metadata Json?
  school School @relation(fields: [schoolId], references: [id])
  guardian Guardian? @relation(fields: [guardianId, schoolId], references: [id, schoolId])
  @@index([schoolId, sentAt])
  @@index([providerMessageId])
  @@index([schoolId, guardianId])
}

