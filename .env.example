# Generate real local secrets with: node scripts/setup-local.mjs
NODE_ENV=development
APP_ORIGIN=http://localhost:8080
WEB_PORT=8080
POSTGRES_PASSWORD=GENERATE_A_RANDOM_PASSWORD
RUNTIME_DB_PASSWORD=GENERATE_48_HEX_CHARACTERS
DATABASE_URL=postgresql://syncacademy:YOUR_PASSWORD@localhost:55432/syncacademy?connection_limit=10
SESSION_SECRET=GENERATE_AT_LEAST_48_RANDOM_CHARACTERS
DATA_ENCRYPTION_KEY=GENERATE_64_HEX_CHARACTERS
SMTP_HOST=smtp.gmail.com
DOCKER_SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=stanlymbilinyi@gmail.com
SMTP_PASSWORD=leodpsrspelshfors
MAIL_FROM=stanlymbilinyi@gmail.com
TRUST_PROXY_HOPS=0

# Set SMTP_PASSWORD in .env to a Google App Password. Do not use your Gmail password.

# Use postgres on every API replica sharing this database; local is single-instance only.
REALTIME_TRANSPORT=local
# Optional direct PostgreSQL listener URL when DATABASE_URL uses a transaction pooler.
# REALTIME_DATABASE_URL=postgresql://...
