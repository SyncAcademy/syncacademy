# Generate real local secrets with: node scripts/setup-local.mjs
NODE_ENV=development
APP_ORIGIN=http://localhost:8080
WEB_PORT=8080
POSTGRES_PASSWORD=GENERATE_A_RANDOM_PASSWORD
RUNTIME_DB_PASSWORD=GENERATE_48_HEX_CHARACTERS
DATABASE_URL=postgresql://syncacademy:YOUR_PASSWORD@localhost:55432/syncacademy?connection_limit=10
SESSION_SECRET=GENERATE_AT_LEAST_48_RANDOM_CHARACTERS
DATA_ENCRYPTION_KEY=GENERATE_64_HEX_CHARACTERS
SMTP_HOST=smtp.gmail.com
DOCKER_SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-user@example.com
SMTP_PASSWORD=YOUR_SMTP_OR_GOOGLE_APP_PASSWORD
MAIL_FROM=noreply@example.com
CONTACT_NOTIFICATION_EMAIL=support@example.com
TRUST_PROXY_HOPS=0

# NextSMS Telecom Gateway (Tanzania SMS & WhatsApp)
# Base URL defaults to https://messaging-service.co.tz
# Generate token in NextSMS Dashboard -> Customer Info -> Customization -> API Keys
NEXTSMS_API_URL=https://messaging-service.co.tz
NEXTSMS_TOKEN=YOUR_NEXTSMS_BEARER_TOKEN
NEXTSMS_SENDER_ID=SYNCACADEMY
NEXTSMS_WHATSAPP_ACCOUNT=SYNCACADEMY
NEXTSMS_WEBHOOK_VERIFY_TOKEN=GENERATE_A_RANDOM_VERIFY_TOKEN
COMMUNICATION_MOCK_DISPATCH=false

# Set SMTP_PASSWORD in .env to a Google App Password or SMTP secret. Never commit real credentials.

# Use postgres on every API replica sharing this database; local is single-instance only.
REALTIME_TRANSPORT=local
# Optional direct PostgreSQL listener URL when DATABASE_URL uses a transaction pooler.
# REALTIME_DATABASE_URL=postgresql://...

